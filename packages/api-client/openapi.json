    }
  },
  "components": {
    "schemas": {
      "CategoryDto": {
        "required": ["categoryId", "name"],
        "type": "object",
        "properties": {
          "categoryId": { "type": "string", "description": "Id Category.", "format": "uuid" },
          "name": { "type": "string", "description": "Tên Category." }
        }
      },
      "ChangePasswordCommand": {
        "required": ["currentPassword", "newPassword"],
        "type": "object",
        "properties": {
          "currentPassword": { "type": ["null", "string"] },
          "newPassword": { "type": ["null", "string"] }
        },
        "description": "Admin đổi mật khẩu của chính mình (FR-42)."
      },
      "CourseDto": {
        "required": [
          "courseId",
          "instructorProfileId",
          "categoryId",
          "title",
          "slug",
          "description",
          "price",
          "status",
          "thumbnailUrl"
        ],
        "type": "object",
        "properties": {
          "courseId": { "type": "string", "description": "Id Khóa học.", "format": "uuid" },
          "instructorProfileId": {
            "type": "string",
            "description": "Id Hồ sơ Instructor sở hữu khóa.",
            "format": "uuid"
          },
          "categoryId": { "type": "string", "description": "Id Category.", "format": "uuid" },
          "title": { "type": "string", "description": "Tiêu đề khóa học." },
          "slug": { "type": "string", "description": "Slug khóa học." },
          "description": {
            "type": ["null", "string"],
            "description": "Mô tả khóa học; `null` khi để trống."
          },
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "description": "Giá (đồng, số nguyên).",
            "format": "double"
          },
          "status": { "type": "string", "description": "Tên trạng thái vòng đời (`Draft`...)." },
          "thumbnailUrl": {
            "type": ["null", "string"],
            "description": "Url ảnh thumbnail; `null` khi chưa có."
          }
        }
      },
      "CreateCourseRequest": {
        "required": ["instructorProfileId", "categoryId", "title", "description", "price"],
        "type": "object",
        "properties": {
          "instructorProfileId": {
            "type": ["null", "string"],
            "description": "Id Hồ sơ Instructor chủ khóa; bắt buộc với Admin, Instructor bỏ trống hoặc truyền hồ sơ của mình.",
            "format": "uuid"
          },
          "categoryId": { "type": "string", "description": "Id Category.", "format": "uuid" },
          "title": {
            "type": ["null", "string"],
            "description": "Tiêu đề khóa học (bắt buộc, tối đa 200 ký tự)."
          },
          "description": {
            "type": ["null", "string"],
            "description": "Mô tả khóa học (tùy chọn, tối đa 5000 ký tự)."
          },
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["null", "number", "string"],
            "description": "Giá bằng đồng, số nguyên không âm (bắt buộc).",
            "format": "double"
          }
        }
      },
      "CreateSampleCommand": {
        "required": ["title"],
        "type": "object",
        "properties": { "title": { "type": ["null", "string"] } },
        "description": "Command mẫu để kiểm chứng pipeline; thay bằng command nghiệp vụ thật khi có."
      },
      "InstructorApprovalDto": {
        "required": ["userId", "instructorProfileId"],
        "type": "object",
        "properties": {
          "userId": { "type": "string", "format": "uuid" },
          "instructorProfileId": { "type": "string", "format": "uuid" }
        }
      },
      "InstructorProfileDto": {
        "required": ["instructorProfileId", "userId", "displayName", "biography", "avatarUrl"],
        "type": "object",
        "properties": {
          "instructorProfileId": {
            "type": "string",
            "description": "Id Hồ sơ Instructor.",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "description": "Id tài khoản của Instructor.",
            "format": "uuid"
          },
          "displayName": {
            "type": ["null", "string"],
            "description": "Tên hiển thị; `null` khi chưa cập nhật lần nào."
          },
          "biography": { "type": ["null", "string"], "description": "Giới thiệu." },
          "avatarUrl": { "type": ["null", "string"], "description": "Url ảnh đại diện." }
        }
      },
      "LessonDto": {
        "required": ["lessonId", "courseId", "lessonTitle", "lessonOrder", "isPreview"],
        "type": "object",
        "properties": {
          "lessonId": { "type": "string", "description": "Id Bài học.", "format": "uuid" },
          "courseId": {
            "type": "string",
            "description": "Id Khóa học chứa bài.",
            "format": "uuid"
          },
          "lessonTitle": { "type": "string", "description": "Tiêu đề bài học." },
          "lessonOrder": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "description": "Thứ tự trong khóa, từ 1.",
            "format": "int32"
          },
          "isPreview": { "type": "boolean", "description": "Có phải Bài học xem thử hay không." }
        }
      },
      "LessonPreviewRequest": {
        "required": ["isPreview"],
        "type": "object",
        "properties": {
          "isPreview": {
            "type": ["null", "boolean"],
            "description": "true để đánh dấu Bài học xem thử, false để bỏ đánh dấu (bắt buộc)."
          }
        }
      },
      "LessonRequest": {
        "required": ["lessonTitle"],
        "type": "object",
        "properties": {
          "lessonTitle": {
            "type": ["null", "string"],
            "description": "Tiêu đề bài học (bắt buộc, tối đa 200 ký tự)."
          }
        }
      },
      "PagedResultOfUserDto": {
        "required": ["items", "pageNumber", "pageSize", "totalCount"],
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/UserDto" } },
          "pageNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "totalCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          }
        }
      },
      "ReorderLessonsRequest": {
        "required": ["lessonIds"],
        "type": "object",
        "properties": {
          "lessonIds": {
            "type": ["null", "array"],
            "items": { "type": "string", "format": "uuid" },
            "description": "Id mọi Bài học của khóa theo thứ tự mới, mỗi bài đúng một lần."
          }
        }
      },
      "SaveCategoryRequest": {
        "required": ["name"],
        "type": "object",
        "properties": {
          "name": {
            "type": ["null", "string"],
            "description": "Tên Category (bắt buộc, tối đa 100 ký tự)."
          }
        }
      },
      "SaveSampleNoteCommand": {
        "required": ["title"],
        "type": "object",
        "properties": { "title": { "type": ["null", "string"] } },
        "description": "Command mẫu ghi vào PostgreSQL qua EF Core."
      },
      "SetThumbnailRequest": {
        "required": ["objectKey"],
        "type": "object",
        "properties": {
          "objectKey": {
            "type": ["null", "string"],
            "description": "Khóa ảnh do `thumbnail-upload` trả về, ảnh đã tải lên xong (bắt buộc)."
          }
        }
      },
      "ThumbnailUploadDto": {
        "required": ["uploadUrl", "objectKey", "contentType", "contentLength", "expiresAt"],
        "type": "object",
        "properties": {
          "uploadUrl": {
            "type": "string",
            "description": "Url PUT đã ký; client gửi thân file kèm đúng header `Content-Type`."
          },
          "objectKey": {
            "type": "string",
