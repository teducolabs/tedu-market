{
  "openapi": "3.1.1",
  "info": { "title": "TeduMarket.Api | v1", "version": "1.0.0" },
  "paths": {
    "/api/v1/account/change-password": {
      "post": {
        "tags": ["Account"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChangePasswordCommand" }
            }
          },
          "required": true
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/users": {
      "get": {
        "tags": ["Users"],
        "parameters": [
          { "name": "role", "in": "query", "schema": { "type": "string" } },
          {
            "name": "pageNumber",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": ["integer", "string"],
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": ["integer", "string"],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PagedResultOfUserDto" }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{userId}/instructor-approval": {
      "post": {
        "tags": ["Users"],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InstructorApprovalDto" }
              }
            }
          }
        }
      }
    },
    "/api/v1/instructor-profiles/me": {
      "get": {
        "tags": ["InstructorProfiles"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InstructorProfileDto" }
              }
            }
          }
        }
      }
    },
    "/api/v1/instructor-profiles/{instructorProfileId}": {
      "get": {
        "tags": ["InstructorProfiles"],
        "parameters": [
          {
            "name": "instructorProfileId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InstructorProfileDto" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["InstructorProfiles"],
        "parameters": [
          {
            "name": "instructorProfileId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateInstructorProfileRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InstructorProfileDto" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["InstructorProfiles"],
        "parameters": [
          {
            "name": "instructorProfileId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/categories": {
      "get": {
        "tags": ["Categories"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/CategoryDto" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Categories"],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SaveCategoryRequest" } }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CategoryDto" } }
            }
          }
        }
      }
    },
    "/api/v1/categories/{categoryId}": {
      "put": {
        "tags": ["Categories"],
        "parameters": [
          {
            "name": "categoryId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SaveCategoryRequest" } }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CategoryDto" } }
            }
          }
        }
      },
      "delete": {
        "tags": ["Categories"],
        "parameters": [
          {
            "name": "categoryId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/samples": {
      "post": {
        "tags": ["Sample"],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CreateSampleCommand" } }
          },
          "required": true
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/samples/notes": {
      "post": {
        "tags": ["Sample"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SaveSampleNoteCommand" }
            }
          },
          "required": true
        },
        "responses": { "200": { "description": "OK" } }
      },
      "get": { "tags": ["Sample"], "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/samples/cached": {
      "get": { "tags": ["Sample"], "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/samples/limited": {
      "get": { "tags": ["Sample"], "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/samples/scheme": {
      "get": { "tags": ["Sample"], "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/samples/admin-only": {
      "get": { "tags": ["Sample"], "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/samples/instructor-only": {
      "get": { "tags": ["Sample"], "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/samples/student-only": {
      "get": { "tags": ["Sample"], "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/samples/owned/{ownerId}": {
      "get": {
        "tags": ["Sample"],
        "parameters": [
          {
            "name": "ownerId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/samples/failure": {
      "get": { "tags": ["Sample"], "responses": { "200": { "description": "OK" } } }
    }
  },
  "components": {
    "schemas": {
      "CategoryDto": {
        "required": ["categoryId", "name"],
        "type": "object",
        "properties": {
          "categoryId": { "type": "string", "description": "Id Category.", "format": "uuid" },
          "name": { "type": "string", "description": "Tên Category." }
        }
      },
      "ChangePasswordCommand": {
        "required": ["currentPassword", "newPassword"],
        "type": "object",
        "properties": {
          "currentPassword": { "type": ["null", "string"] },
          "newPassword": { "type": ["null", "string"] }
        },
        "description": "Admin đổi mật khẩu của chính mình (FR-42)."
      },
      "CreateSampleCommand": {
        "required": ["title"],
        "type": "object",
        "properties": { "title": { "type": ["null", "string"] } },
        "description": "Command mẫu để kiểm chứng pipeline; thay bằng command nghiệp vụ thật khi có."
      },
      "InstructorApprovalDto": {
        "required": ["userId", "instructorProfileId"],
        "type": "object",
        "properties": {
          "userId": { "type": "string", "format": "uuid" },
          "instructorProfileId": { "type": "string", "format": "uuid" }
        }
      },
      "InstructorProfileDto": {
        "required": ["instructorProfileId", "userId", "displayName", "biography", "avatarUrl"],
        "type": "object",
        "properties": {
          "instructorProfileId": {
            "type": "string",
            "description": "Id Hồ sơ Instructor.",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "description": "Id tài khoản của Instructor.",
            "format": "uuid"
          },
          "displayName": {
            "type": ["null", "string"],
            "description": "Tên hiển thị; `null` khi chưa cập nhật lần nào."
          },
          "biography": { "type": ["null", "string"], "description": "Giới thiệu." },
          "avatarUrl": { "type": ["null", "string"], "description": "Url ảnh đại diện." }
        }
      },
      "PagedResultOfUserDto": {
        "required": ["items", "pageNumber", "pageSize", "totalCount"],
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/UserDto" } },
          "pageNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "totalCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          }
        }
      },
      "SaveCategoryRequest": {
        "required": ["name"],
        "type": "object",
        "properties": {
          "name": {
            "type": ["null", "string"],
            "description": "Tên Category (bắt buộc, tối đa 100 ký tự)."
          }
        }
      },
      "SaveSampleNoteCommand": {
        "required": ["title"],
        "type": "object",
        "properties": { "title": { "type": ["null", "string"] } },
        "description": "Command mẫu ghi vào PostgreSQL qua EF Core."
      },
      "UpdateInstructorProfileRequest": {
        "required": ["displayName", "biography", "avatarUrl"],
        "type": "object",
        "properties": {
          "displayName": { "type": ["null", "string"], "description": "Tên hiển thị (bắt buộc)." },
          "biography": { "type": ["null", "string"], "description": "Giới thiệu (tùy chọn)." },
          "avatarUrl": {
            "type": ["null", "string"],
            "description": "Url ảnh đại diện http/https (tùy chọn)."
          }
        }
      },
      "UserDto": {
        "required": ["userId", "email", "roles", "instructorProfileId", "displayName"],
        "type": "object",
        "properties": {
          "userId": { "type": "string", "description": "Id tài khoản.", "format": "uuid" },
          "email": { "type": ["null", "string"], "description": "Email đăng nhập." },
          "roles": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Tên các vai trò."
          },
          "instructorProfileId": {
            "type": ["null", "string"],
            "description": "Id Hồ sơ Instructor; `null` nếu chưa được duyệt.",
            "format": "uuid"
          },
          "displayName": {
            "type": ["null", "string"],
            "description": "Tên hiển thị trong Hồ sơ Instructor; `null` nếu chưa có hồ sơ hoặc chưa cập nhật lần nào."
          }
        }
      }
    }
  },
  "tags": [
    { "name": "Account" },
    { "name": "Users" },
    { "name": "InstructorProfiles" },
    { "name": "Categories" },
    { "name": "Sample" }
  ]
}
