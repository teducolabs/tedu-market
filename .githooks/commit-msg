#!/bin/sh
# Chặn commit sai định dạng "T<số>: <mô tả>" (conventions.md §1).
first_line=$(head -n 1 "$1")
if ! printf '%s' "$first_line" | grep -Eq '^T[0-9]+: .{5,72}$'; then
  echo "Commit message không hợp lệ: '$first_line'" >&2
  echo "Định dạng: T<số>: <động từ + việc, tiếng Việt, 5-72 ký tự>  (vd: T123: thêm API đăng ký học viên)" >&2
  exit 1
fi
