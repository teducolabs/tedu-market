# Chỉ chứa tên biến. Local: cp .env.example .env.local rồi tự sinh giá trị giả (openssl rand -hex 32).
POSTGRES_PASSWORD=
ConnectionStrings__Default=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Tùy chọn (để trống thì tắt tính năng tương ứng). Giá trị thật chỉ ghi vào .env.local, KHÔNG commit.
# Đăng nhập Google: tạo OAuth client ở Google Cloud Console, redirect URI http://localhost:5000/signin-google
Google__ClientId=
Google__ClientSecret=
# Email qua Resend: FromAddress cần domain đã xác minh ở Resend, bọc dấu nháy vì có khoảng trắng,
# ví dụ "TEDU Market <no-reply@domain>" (Resend có địa chỉ thử onboarding@resend.dev cho tài khoản của bạn)
Resend__ApiKey=
Resend__FromAddress=
