{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "generate": {
      "inputs": ["openapi.json", "package.json"],
      "outputs": ["src/client/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate", "^generate"],
      "outputs": ["dist/**", ".next/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "generate", "^generate"]
    },
    "test": {
      "dependsOn": ["generate", "^generate"]
    }
  }
}
