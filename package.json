    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "turbo": "2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
